{
  "info": {
    "name": "NexusGame — GameStore API",
    "description": "Collection de tests API pour le projet final 2TES3. Chaînage d'ID créé vers les requêtes suivantes avec variables de collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "description": "URL de base de l'API GameStore"
    },
    {
      "key": "created_game_id",
      "value": "",
      "description": "ID du jeu créé — rempli automatiquement par la requête de création"
    },
    {
      "key": "created_game_title",
      "value": "",
      "description": "Titre du jeu créé — utilisé pour valider la recherche"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Status ok', function () { pm.expect(jsonData.status).to.eql('ok'); });",
              "pm.test('Service GameStore API', function () { pm.expect(jsonData.service).to.eql('GameStore API'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Lister les jeux",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Réponse est un tableau', function () { pm.expect(jsonData).to.be.an('array'); });",
              "pm.test('Liste non vide', function () { pm.expect(jsonData.length).to.be.above(0); });",
              "pm.test('Chaque jeu contient les champs requis', function () { pm.expect(jsonData.every(g => g.id && g.title && g.genre && g.price !== undefined && g.rating !== undefined)).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Créer un jeu",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/games",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"NexusGame Test {{$timestamp}}\",\n  \"genre\": \"RPG\",\n  \"price\": 49.99,\n  \"rating\": 4.5,\n  \"stock\": 100\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.test('ID présent', function () { pm.expect(jsonData.id).to.be.a('number'); });",
              "pm.test('Titre contient NexusGame Test', function () { pm.expect(jsonData.title).to.include('NexusGame Test'); });",
              "pm.collectionVariables.set('created_game_id', jsonData.id);",
              "pm.collectionVariables.set('created_game_title', jsonData.title);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Récupérer le jeu créé",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games/{{created_game_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('ID correspond', function () { pm.expect(jsonData.id.toString()).to.eql(pm.collectionVariables.get('created_game_id').toString()); });",
              "pm.test('Genre est RPG', function () { pm.expect(jsonData.genre).to.eql('RPG'); });",
              "pm.test('Prix est 49.99', function () { pm.expect(jsonData.price).to.eql(49.99); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Mettre à jour le stock",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/games/{{created_game_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Stock mis à jour', function () { pm.expect(jsonData.stock).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Rechercher le jeu créé",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games/search?q={{created_game_title}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Au moins un résultat', function () { pm.expect(jsonData.count).to.be.at.least(1); });",
              "pm.test('Résultat contient le titre créé', function () { pm.expect(jsonData.results.some(g => g.title === pm.collectionVariables.get('created_game_title'))).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Filtrer par genre RPG",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games?genre=RPG"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Tous les jeux sont RPG', function () { pm.expect(jsonData.every(g => g.genre === 'RPG')).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Statistiques des jeux",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('total_games présent', function () { pm.expect(jsonData).to.have.property('total_games'); });",
              "pm.test('genres présent', function () { pm.expect(jsonData).to.have.property('genres'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Créer un jeu dupliqué → 409",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/games",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{created_game_title}}\",\n  \"genre\": \"RPG\",\n  \"price\": 49.99\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409', function () { pm.response.to.have.status(409); });",
              "var jsonData = pm.response.json();",
              "pm.test('Erreur d\\'unicité', function () { pm.expect(jsonData.error).to.include('existe'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Créer un jeu invalide → 400",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/games",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"genre\": \"RPG\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
              "var jsonData = pm.response.json();",
              "pm.test('Détails d\\'erreur présents', function () { pm.expect(jsonData).to.have.property('details'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Supprimer le jeu créé",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/games/{{created_game_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Vérifier suppression (404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/games/{{created_game_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Lister les genres disponibles",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/genres"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Liste de genres non vide', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
            ]
          }
        }
      ]
    }
  ]
}